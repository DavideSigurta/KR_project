<?xml version="1.0"?>
<Ontology xmlns="http://www.w3.org/2002/07/owl#"
     xml:base="http://www.semanticweb.org/smarthome/ontologies/2026/smarthome"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     ontologyIRI="http://www.semanticweb.org/smarthome/ontologies/2026/smarthome">
    <Prefix name="" IRI="http://www.semanticweb.org/smarthome/ontologies/2026/smarthome/"/>
    <Prefix name="owl" IRI="http://www.w3.org/2002/07/owl#"/>
    <Prefix name="rdf" IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#"/>
    <Prefix name="xml" IRI="http://www.w3.org/XML/1998/namespace"/>
    <Prefix name="xsd" IRI="http://www.w3.org/2001/XMLSchema#"/>
    <Prefix name="rdfs" IRI="http://www.w3.org/2000/01/rdf-schema#"/>

    <Declaration><Class IRI="#Location"/></Declaration>
    <Declaration><Class IRI="#Room"/></Declaration>
    <Declaration><Class IRI="#Zone"/></Declaration>
    <Declaration><Class IRI="#OutdoorSpace"/></Declaration>
    <Declaration><Class IRI="#Device"/></Declaration>
    <Declaration><Class IRI="#Sensor"/></Declaration>
    <Declaration><Class IRI="#Actuator"/></Declaration>
    <Declaration><Class IRI="#TemperatureSensor"/></Declaration>
    <Declaration><Class IRI="#MotionSensor"/></Declaration>
    <Declaration><Class IRI="#Camera"/></Declaration>
    <Declaration><Class IRI="#Light"/></Declaration>
    <Declaration><Class IRI="#Thermostat"/></Declaration>
    <Declaration><Class IRI="#SmartLock"/></Declaration>
    <Declaration><Class IRI="#Controller"/></Declaration>
    <Declaration><Class IRI="#MobileApp"/></Declaration>
    <Declaration><Class IRI="#HomeHub"/></Declaration>
    <Declaration><Class IRI="#Scene"/></Declaration>
    <Declaration><Class IRI="#Network"/></Declaration>
    <Declaration><Class IRI="#ActiveDevice"/></Declaration>
    <Declaration><Class IRI="#MonitoredLocation"/></Declaration>
    <Declaration><Class IRI="#EquippedRoom"/></Declaration>
    <Declaration><Class IRI="#ClimateControlledRoom"/></Declaration>
    <Declaration><Class IRI="#SensorOnlyRoom"/></Declaration>
    <Declaration><Class IRI="#WellEquippedRoom"/></Declaration>
    <Declaration><Class IRI="#HubControlledDevice"/></Declaration>

    <Declaration><ObjectProperty IRI="#locatedIn"/></Declaration>
    <Declaration><ObjectProperty IRI="#contains"/></Declaration>
    <Declaration><ObjectProperty IRI="#hasRoom"/></Declaration>
    <Declaration><ObjectProperty IRI="#isPartOfZone"/></Declaration>
    <Declaration><ObjectProperty IRI="#monitors"/></Declaration>
    <Declaration><ObjectProperty IRI="#isMonitoredBy"/></Declaration>
    <Declaration><ObjectProperty IRI="#controls"/></Declaration>
    <Declaration><ObjectProperty IRI="#isControlledBy"/></Declaration>
    <Declaration><ObjectProperty IRI="#activates"/></Declaration>
    <Declaration><ObjectProperty IRI="#connectedTo"/></Declaration>
    <Declaration><ObjectProperty IRI="#isLocatedInZone"/></Declaration>

    <Declaration><DataProperty IRI="#deviceName"/></Declaration>
    <Declaration><DataProperty IRI="#temperatureValue"/></Declaration>
    <Declaration><DataProperty IRI="#brightnessLevel"/></Declaration>
    <Declaration><DataProperty IRI="#isActive"/></Declaration>

    <Declaration><NamedIndividual IRI="#LivingRoom"/></Declaration>
    <Declaration><NamedIndividual IRI="#Kitchen"/></Declaration>
    <Declaration><NamedIndividual IRI="#Bedroom"/></Declaration>
    <Declaration><NamedIndividual IRI="#SecurityRoom"/></Declaration>
    <Declaration><NamedIndividual IRI="#Garden"/></Declaration>
    <Declaration><NamedIndividual IRI="#LivingArea"/></Declaration>
    <Declaration><NamedIndividual IRI="#NightZone"/></Declaration>
    <Declaration><NamedIndividual IRI="#GardenCam"/></Declaration>
    <Declaration><NamedIndividual IRI="#EntranceCam"/></Declaration>
    <Declaration><NamedIndividual IRI="#BedroomMotion"/></Declaration>
    <Declaration><NamedIndividual IRI="#SecurityMotion"/></Declaration>
    <Declaration><NamedIndividual IRI="#KitchenTempSensor"/></Declaration>
    <Declaration><NamedIndividual IRI="#Nest_Thermo"/></Declaration>
    <Declaration><NamedIndividual IRI="#HueBulb_01"/></Declaration>
    <Declaration><NamedIndividual IRI="#BedroomLight"/></Declaration>
    <Declaration><NamedIndividual IRI="#FrontDoorLock"/></Declaration>
    <Declaration><NamedIndividual IRI="#MainHub"/></Declaration>
    <Declaration><NamedIndividual IRI="#OwnerPhone"/></Declaration>
    <Declaration><NamedIndividual IRI="#NightMode"/></Declaration>
    <Declaration><NamedIndividual IRI="#HomeWifi"/></Declaration>

    <SubClassOf><Class IRI="#Room"/><Class IRI="#Location"/></SubClassOf>
    <SubClassOf><Class IRI="#Zone"/><Class IRI="#Location"/></SubClassOf>
    <SubClassOf><Class IRI="#OutdoorSpace"/><Class IRI="#Location"/></SubClassOf>
    <SubClassOf><Class IRI="#Sensor"/><Class IRI="#Device"/></SubClassOf>
    <SubClassOf><Class IRI="#Actuator"/><Class IRI="#Device"/></SubClassOf>
    <SubClassOf><Class IRI="#TemperatureSensor"/><Class IRI="#Sensor"/></SubClassOf>
    <SubClassOf><Class IRI="#MotionSensor"/><Class IRI="#Sensor"/></SubClassOf>
    <SubClassOf><Class IRI="#Camera"/><Class IRI="#Sensor"/></SubClassOf>
    <SubClassOf><Class IRI="#Light"/><Class IRI="#Actuator"/></SubClassOf>
    <SubClassOf><Class IRI="#Thermostat"/><Class IRI="#Actuator"/></SubClassOf>
    <SubClassOf><Class IRI="#SmartLock"/><Class IRI="#Actuator"/></SubClassOf>
    <SubClassOf><Class IRI="#MobileApp"/><Class IRI="#Controller"/></SubClassOf>
    <SubClassOf><Class IRI="#HomeHub"/><Class IRI="#Controller"/></SubClassOf>

    <DisjointClasses>
        <Class IRI="#Location"/>
        <Class IRI="#Device"/>
        <Class IRI="#Controller"/>
        <Class IRI="#Scene"/>
        <Class IRI="#Network"/>
    </DisjointClasses>

    <DisjointUnion>
        <Class IRI="#Location"/>
        <Class IRI="#Room"/>
        <Class IRI="#Zone"/>
        <Class IRI="#OutdoorSpace"/>
    </DisjointUnion>

    <DisjointClasses>
        <Class IRI="#Sensor"/>
        <Class IRI="#Actuator"/>
    </DisjointClasses>

    <DisjointClasses>
        <Class IRI="#Camera"/>
        <Class IRI="#MotionSensor"/>
        <Class IRI="#TemperatureSensor"/>
    </DisjointClasses>

    <DisjointClasses>
        <Class IRI="#Light"/>
        <Class IRI="#Thermostat"/>
        <Class IRI="#SmartLock"/>
    </DisjointClasses>

    <DisjointClasses>
        <Class IRI="#MobileApp"/>
        <Class IRI="#HomeHub"/>
    </DisjointClasses>

    <EquivalentClasses>
        <Class IRI="#ActiveDevice"/>
        <ObjectIntersectionOf>
            <Class IRI="#Device"/>
            <DataHasValue>
                <DataProperty IRI="#isActive"/>
                <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#boolean">true</Literal>
            </DataHasValue>
        </ObjectIntersectionOf>
    </EquivalentClasses>

    <EquivalentClasses>
        <Class IRI="#MonitoredLocation"/>
        <ObjectIntersectionOf>
            <Class IRI="#Location"/>
            <ObjectSomeValuesFrom>
                <ObjectProperty IRI="#isMonitoredBy"/>
                <Class IRI="#Camera"/>
            </ObjectSomeValuesFrom>
        </ObjectIntersectionOf>
    </EquivalentClasses>

    <EquivalentClasses>
        <Class IRI="#EquippedRoom"/>
        <ObjectIntersectionOf>
            <Class IRI="#Room"/>
            <ObjectSomeValuesFrom>
                <ObjectProperty IRI="#contains"/>
                <Class IRI="#Device"/>
            </ObjectSomeValuesFrom>
        </ObjectIntersectionOf>
    </EquivalentClasses>

    <EquivalentClasses>
        <Class IRI="#ClimateControlledRoom"/>
        <ObjectIntersectionOf>
            <Class IRI="#Room"/>
            <ObjectSomeValuesFrom>
                <ObjectProperty IRI="#contains"/>
                <Class IRI="#Thermostat"/>
            </ObjectSomeValuesFrom>
        </ObjectIntersectionOf>
    </EquivalentClasses>

    <EquivalentClasses>
        <Class IRI="#SensorOnlyRoom"/>
        <ObjectIntersectionOf>
            <Class IRI="#Room"/>
            <ObjectAllValuesFrom>
                <ObjectProperty IRI="#contains"/>
                <Class IRI="#Sensor"/>
            </ObjectAllValuesFrom>
        </ObjectIntersectionOf>
    </EquivalentClasses>

    <EquivalentClasses>
        <Class IRI="#WellEquippedRoom"/>
        <ObjectIntersectionOf>
            <Class IRI="#Room"/>
            <ObjectMinCardinality cardinality="2">
                <ObjectProperty IRI="#contains"/>
                <Class IRI="#Device"/>
            </ObjectMinCardinality>
        </ObjectIntersectionOf>
    </EquivalentClasses>

    <EquivalentClasses>
        <Class IRI="#HubControlledDevice"/>
        <ObjectIntersectionOf>
            <Class IRI="#Device"/>
            <ObjectAllValuesFrom>
                <ObjectProperty IRI="#isControlledBy"/>
                <Class IRI="#HomeHub"/>
            </ObjectAllValuesFrom>
        </ObjectIntersectionOf>
    </EquivalentClasses>

    <SubObjectPropertyOf>
        <ObjectPropertyChain>
            <ObjectProperty IRI="#locatedIn"/>
            <ObjectProperty IRI="#isPartOfZone"/>
        </ObjectPropertyChain>
        <ObjectProperty IRI="#isLocatedInZone"/>
    </SubObjectPropertyOf>

    <InverseObjectProperties>
        <ObjectProperty IRI="#locatedIn"/>
        <ObjectProperty IRI="#contains"/>
    </InverseObjectProperties>
    <InverseObjectProperties>
        <ObjectProperty IRI="#hasRoom"/>
        <ObjectProperty IRI="#isPartOfZone"/>
    </InverseObjectProperties>
    <InverseObjectProperties>
        <ObjectProperty IRI="#monitors"/>
        <ObjectProperty IRI="#isMonitoredBy"/>
    </InverseObjectProperties>
    <InverseObjectProperties>
        <ObjectProperty IRI="#controls"/>
        <ObjectProperty IRI="#isControlledBy"/>
    </InverseObjectProperties>

    <FunctionalObjectProperty>
        <ObjectProperty IRI="#locatedIn"/>
    </FunctionalObjectProperty>
    <FunctionalObjectProperty>
        <ObjectProperty IRI="#connectedTo"/>
    </FunctionalObjectProperty>

    <ObjectPropertyDomain>
        <ObjectProperty IRI="#locatedIn"/>
        <Class IRI="#Device"/>
    </ObjectPropertyDomain>
    <ObjectPropertyDomain>
        <ObjectProperty IRI="#contains"/>
        <Class IRI="#Room"/>
    </ObjectPropertyDomain>
    <ObjectPropertyDomain>
        <ObjectProperty IRI="#hasRoom"/>
        <Class IRI="#Zone"/>
    </ObjectPropertyDomain>
    <ObjectPropertyDomain>
        <ObjectProperty IRI="#isPartOfZone"/>
        <Class IRI="#Room"/>
    </ObjectPropertyDomain>
    <ObjectPropertyDomain>
        <ObjectProperty IRI="#monitors"/>
        <Class IRI="#Camera"/>
    </ObjectPropertyDomain>
    <ObjectPropertyDomain>
        <ObjectProperty IRI="#isMonitoredBy"/>
        <Class IRI="#Location"/>
    </ObjectPropertyDomain>
    <ObjectPropertyDomain>
        <ObjectProperty IRI="#controls"/>
        <Class IRI="#Controller"/>
    </ObjectPropertyDomain>
    <ObjectPropertyDomain>
        <ObjectProperty IRI="#isControlledBy"/>
        <Class IRI="#Device"/>
    </ObjectPropertyDomain>
    <ObjectPropertyDomain>
        <ObjectProperty IRI="#activates"/>
        <Class IRI="#Controller"/>
    </ObjectPropertyDomain>
    <ObjectPropertyDomain>
        <ObjectProperty IRI="#connectedTo"/>
        <Class IRI="#Device"/>
    </ObjectPropertyDomain>
    <ObjectPropertyDomain>
        <ObjectProperty IRI="#isLocatedInZone"/>
        <Class IRI="#Device"/>
    </ObjectPropertyDomain>

    <ObjectPropertyRange>
        <ObjectProperty IRI="#locatedIn"/>
        <Class IRI="#Room"/>
    </ObjectPropertyRange>
    <ObjectPropertyRange>
        <ObjectProperty IRI="#contains"/>
        <Class IRI="#Device"/>
    </ObjectPropertyRange>
    <ObjectPropertyRange>
        <ObjectProperty IRI="#hasRoom"/>
        <Class IRI="#Room"/>
    </ObjectPropertyRange>
    <ObjectPropertyRange>
        <ObjectProperty IRI="#isPartOfZone"/>
        <Class IRI="#Zone"/>
    </ObjectPropertyRange>
    <ObjectPropertyRange>
        <ObjectProperty IRI="#monitors"/>
        <Class IRI="#Location"/>
    </ObjectPropertyRange>
    <ObjectPropertyRange>
        <ObjectProperty IRI="#isMonitoredBy"/>
        <Class IRI="#Camera"/>
    </ObjectPropertyRange>
    <ObjectPropertyRange>
        <ObjectProperty IRI="#controls"/>
        <Class IRI="#Device"/>
    </ObjectPropertyRange>
    <ObjectPropertyRange>
        <ObjectProperty IRI="#isControlledBy"/>
        <Class IRI="#Controller"/>
    </ObjectPropertyRange>
    <ObjectPropertyRange>
        <ObjectProperty IRI="#activates"/>
        <Class IRI="#Scene"/>
    </ObjectPropertyRange>
    <ObjectPropertyRange>
        <ObjectProperty IRI="#connectedTo"/>
        <Class IRI="#Network"/>
    </ObjectPropertyRange>
    <ObjectPropertyRange>
        <ObjectProperty IRI="#isLocatedInZone"/>
        <Class IRI="#Zone"/>
    </ObjectPropertyRange>

    <FunctionalDataProperty>
        <DataProperty IRI="#deviceName"/>
    </FunctionalDataProperty>

    <DataPropertyDomain>
        <DataProperty IRI="#deviceName"/>
        <Class IRI="#Device"/>
    </DataPropertyDomain>
    <DataPropertyDomain>
        <DataProperty IRI="#temperatureValue"/>
        <Class IRI="#TemperatureSensor"/>
    </DataPropertyDomain>
    <DataPropertyDomain>
        <DataProperty IRI="#brightnessLevel"/>
        <Class IRI="#Light"/>
    </DataPropertyDomain>
    <DataPropertyDomain>
        <DataProperty IRI="#isActive"/>
        <Class IRI="#Device"/>
    </DataPropertyDomain>

    <DataPropertyRange>
        <DataProperty IRI="#deviceName"/>
        <Datatype abbreviatedIRI="xsd:string"/>
    </DataPropertyRange>
    <DataPropertyRange>
        <DataProperty IRI="#temperatureValue"/>
        <Datatype abbreviatedIRI="xsd:float"/>
    </DataPropertyRange>
    <DataPropertyRange>
        <DataProperty IRI="#brightnessLevel"/>
        <Datatype abbreviatedIRI="xsd:integer"/>
    </DataPropertyRange>
    <DataPropertyRange>
        <DataProperty IRI="#isActive"/>
        <Datatype abbreviatedIRI="xsd:boolean"/>
    </DataPropertyRange>

    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Location</IRI>
        <Literal>Location</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Location</IRI>
        <Literal>A spatial entity in the smart home. Every Location is exactly one of: Room, Zone, or OutdoorSpace (DisjointUnion).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Room</IRI>
        <Literal>Room</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Room</IRI>
        <Literal>A physical indoor space enclosed by walls (e.g. Kitchen, Bedroom, LivingRoom). Disjoint from Zone and OutdoorSpace.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Zone</IRI>
        <Literal>Zone</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Zone</IRI>
        <Literal>A logical grouping of one or more Rooms, used to apply automation at higher granularity than a single room.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#OutdoorSpace</IRI>
        <Literal>Outdoor Space</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#OutdoorSpace</IRI>
        <Literal>A physical outdoor area (e.g. Garden). Disjoint from Room and Zone. Cameras can monitor OutdoorSpaces.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Device</IRI>
        <Literal>Device</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Device</IRI>
        <Literal>A smart physical device installed in the home. Every Device is either a Sensor or an Actuator. Disjoint from Location, Controller, Scene, Network.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Sensor</IRI>
        <Literal>Sensor</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Sensor</IRI>
        <Literal>A Device that measures or detects physical phenomena (temperature, motion, image). Disjoint from Actuator.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Actuator</IRI>
        <Literal>Actuator</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Actuator</IRI>
        <Literal>A Device that performs physical actions in response to commands. Disjoint from Sensor.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TemperatureSensor</IRI>
        <Literal>Temperature Sensor</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#TemperatureSensor</IRI>
        <Literal>A Sensor that measures ambient temperature in Celsius (xsd:float).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#MotionSensor</IRI>
        <Literal>Motion Sensor</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#MotionSensor</IRI>
        <Literal>A Sensor that detects movement in a Room.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Camera</IRI>
        <Literal>Camera</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Camera</IRI>
        <Literal>A Sensor that captures video of a Location via the monitors property.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Light</IRI>
        <Literal>Light</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Light</IRI>
        <Literal>An Actuator controlling room illumination. Brightness expressed as integer 0-100.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Thermostat</IRI>
        <Literal>Thermostat</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Thermostat</IRI>
        <Literal>An Actuator that regulates room temperature. A Room containing a Thermostat is inferred ClimateControlledRoom.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#SmartLock</IRI>
        <Literal>Smart Lock</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#SmartLock</IRI>
        <Literal>An Actuator controlling physical access. Assigned to the nearest room for simplicity.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Controller</IRI>
        <Literal>Controller</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Controller</IRI>
        <Literal>An entity that issues commands to Devices and activates Scenes.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#MobileApp</IRI>
        <Literal>Mobile App</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#MobileApp</IRI>
        <Literal>A Controller on a smartphone allowing remote control of Devices.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#HomeHub</IRI>
        <Literal>Home Hub</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#HomeHub</IRI>
        <Literal>A local Controller that orchestrates device automation on the home network.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Scene</IRI>
        <Literal>Scene</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Scene</IRI>
        <Literal>A named automation configuration (e.g. NightMode).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Network</IRI>
        <Literal>Network</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Network</IRI>
        <Literal>A connectivity infrastructure (e.g. WiFi) to which Devices connect. Each Device connects to exactly one Network (Functional).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#ActiveDevice</IRI>
        <Literal>Active Device</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#ActiveDevice</IRI>
        <Literal>DEFINED CLASS: Device and (isActive value true). Reasoner auto-classifies any Device with isActive=true.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#MonitoredLocation</IRI>
        <Literal>Monitored Location</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#MonitoredLocation</IRI>
        <Literal>DEFINED CLASS: Location and (isMonitoredBy some Camera). Uses existential restriction and inverse property.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#EquippedRoom</IRI>
        <Literal>Equipped Room</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#EquippedRoom</IRI>
        <Literal>DEFINED CLASS: Room and (contains some Device). Uses existential restriction via inverse of locatedIn.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#ClimateControlledRoom</IRI>
        <Literal>Climate Controlled Room</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#ClimateControlledRoom</IRI>
        <Literal>DEFINED CLASS: Room and (contains some Thermostat). Reasoner also infers ClimateControlledRoom is subclass of EquippedRoom.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#SensorOnlyRoom</IRI>
        <Literal>Sensor Only Room</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#SensorOnlyRoom</IRI>
        <Literal>DEFINED CLASS: Room and (contains only Sensor). Uses universal restriction. SecurityRoom is the ABox instance that qualifies.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#WellEquippedRoom</IRI>
        <Literal>Well Equipped Room</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#WellEquippedRoom</IRI>
        <Literal>DEFINED CLASS: Room and (contains min 2 Device). Uses qualified cardinality restriction from ALCN. LivingRoom, Kitchen, Bedroom qualify. SecurityRoom does not.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#HubControlledDevice</IRI>
        <Literal>Hub Controlled Device</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#HubControlledDevice</IRI>
        <Literal>DEFINED CLASS: Device and (isControlledBy only HomeHub). FrontDoorLock and GardenCam are also controlled by OwnerPhone (MobileApp) so they do not qualify.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#isLocatedInZone</IRI>
        <Literal>is Located In Zone</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#isLocatedInZone</IRI>
        <Literal>Inferred via property chain: locatedIn o isPartOfZone. If a Device is in a Room and that Room isPartOfZone a Zone, the reasoner infers the Device isLocatedInZone that Zone.</Literal>
    </AnnotationAssertion>

    <ClassAssertion>
        <Class IRI="#Room"/>
        <NamedIndividual IRI="#LivingRoom"/>
    </ClassAssertion>
    <ClassAssertion>
        <Class IRI="#Room"/>
        <NamedIndividual IRI="#Kitchen"/>
    </ClassAssertion>
    <ClassAssertion>
        <Class IRI="#Room"/>
        <NamedIndividual IRI="#Bedroom"/>
    </ClassAssertion>
    <ClassAssertion>
        <Class IRI="#Room"/>
        <NamedIndividual IRI="#SecurityRoom"/>
    </ClassAssertion>
    <ClassAssertion>
        <Class IRI="#OutdoorSpace"/>
        <NamedIndividual IRI="#Garden"/>
    </ClassAssertion>
    <ClassAssertion>
        <Class IRI="#Zone"/>
        <NamedIndividual IRI="#LivingArea"/>
    </ClassAssertion>
    <ClassAssertion>
        <Class IRI="#Zone"/>
        <NamedIndividual IRI="#NightZone"/>
    </ClassAssertion>
    <ClassAssertion>
        <Class IRI="#Camera"/>
        <NamedIndividual IRI="#GardenCam"/>
    </ClassAssertion>
    <ClassAssertion>
        <Class IRI="#Camera"/>
        <NamedIndividual IRI="#EntranceCam"/>
    </ClassAssertion>
    <ClassAssertion>
        <Class IRI="#MotionSensor"/>
        <NamedIndividual IRI="#BedroomMotion"/>
    </ClassAssertion>
    <ClassAssertion>
        <Class IRI="#MotionSensor"/>
